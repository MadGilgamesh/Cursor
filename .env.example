# Skopiuj do `.env` w katalogu głównym repozytorium: cp .env.example .env
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://game:game@localhost:5432/game
REDIS_URL=redis://localhost:6379
SESSION_TTL_DAYS=30
AUTH_RATE_LIMIT_MAX=20

# Web Push (opcjonalnie). Klucze: pnpm --filter @game/api vapid:generate
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com
