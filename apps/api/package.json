{
  "name": "@game/api",
  "version": "0.0.0",
  "private": true,
  "description": "Autorytatywny serwer gry: HTTP API, baza danych, kolejki zadań.",
  "type": "module",
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "dev:worker": "tsx watch --env-file-if-exists=../../.env src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts",
    "db:migrate:prod": "node dist/db/migrate.js",
    "vapid:generate": "web-push generate-vapid-keys"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "http_ece": "1.2.0",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@game/shared": "workspace:*",
    "argon2": "^0.45.1",
    "bullmq": "^6.5.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "ioredis": "^6.0.0",
    "postgres": "^3.4.9",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  }
}
