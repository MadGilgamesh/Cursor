{
  "name": "@game/panel",
  "version": "0.0.0",
  "private": true,
  "description": "Kancelaria — panel administracyjny i edytor treści gry Zapomniany Brzeg.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env server/main.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.server.build.json && vite build",
    "start": "node dist/server/main.js",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.build.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "pnpm build && playwright test"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@tanstack/react-query": "^5.105.0",
    "@game/content": "workspace:*",
    "@game/shared": "workspace:*",
    "argon2": "^0.45.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "pino-pretty": "^13.2.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
